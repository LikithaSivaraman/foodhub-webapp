<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>FoodHub Restaurant</title>

    <link rel="stylesheet"
          href="css/style.css">

</head>

<body>

    <!-- Navigation -->

    <header>

        <div class="logo">
            Food<span>Hub</span>
        </div>

        <nav>

            <a href="#home">Home</a>
            <a href="#menu">Menu</a>
            <a href="#about">About</a>
            <a href="#contact">Contact</a>

        </nav>

    </header>


    <!-- Hero Section -->

    <section id="home" class="hero">

        <div class="hero-content">

            <p class="small-title">
                WELCOME TO FOODHUB
            </p>

            <h1>
                Delicious Food.....!
                <br>
                Made With Love.
            </h1>

            <p>
                Fresh ingredients, delicious recipes and
                unforgettable flavours.
            </p>

            <a href="#menu" class="button">
                Explore Our Menu
            </a>

        </div>

    </section>


    <!-- Menu -->

    <section id="menu" class="menu">

        <p class="section-title">
            OUR SPECIALS
        </p>

        <h2>
            Popular Dishes
        </h2>

        <div class="food-container">


            <div class="food-card">

                <div class="food-image pizza">
                    🍕
                </div>

                <div class="food-content">

                    <h3>
                        Italian Pizza
                    </h3>

                    <p>
                        Fresh vegetables, mozzarella
                        and our special tomato sauce.
                    </p>

                    <strong>
                        ₹299
                    </strong>

                </div>

            </div>


            <div class="food-card">

                <div class="food-image burger">
                    🍔
                </div>

                <div class="food-content">

                    <h3>
                        Classic Burger
                    </h3>

                    <p>
                        Juicy grilled patty with fresh
                        vegetables and special sauce.
                    </p>

                    <strong>
                        ₹199
                    </strong>

                </div>

            </div>


            <div class="food-card">

                <div class="food-image pasta">
                    🍝
                </div>

                <div class="food-content">

                    <h3>
                        Creamy Pasta
                    </h3>

                    <p>
                        Creamy Italian pasta prepared
                        with fresh herbs and cheese.
                    </p>

                    <strong>
                        ₹249
                    </strong>

                </div>

            </div>


        </div>

    </section>


    <!-- About -->

    <section id="about" class="about">

        <div>

            <p class="section-title">
                ABOUT US
            </p>

            <h2>
                Good Food Brings
                People Together
            </h2>

            <p>
                At FoodHub, we believe great food should
                be fresh, simple and memorable.
            </p>

            <p>
                Our chefs prepare every dish using
                carefully selected ingredients and
                traditional cooking techniques.
            </p>

        </div>

        <div class="about-box">

            <div>
                <h3>10+</h3>
                <p>Years Experience</p>
            </div>

            <div>
                <h3>50+</h3>
                <p>Special Dishes</p>
            </div>

            <div>
                <h3>10K+</h3>
                <p>Happy Customers</p>
            </div>

        </div>

    </section>


    <!-- Contact -->

    <section id="contact" class="contact">

        <p class="section-title">
            VISIT US
        </p>

        <h2>
            Come & Enjoy
            Great Food
        </h2>

        <p>
            25 Anna Salai, Chennai
        </p>

        <p>
            📞 +91 98765 43210
        </p>

        <p>
            ✉ hello@foodhub.com
        </p>

    </section>


    <!-- Footer -->

    <footer>

        <p>
            © 2026 FoodHub Restaurant
        </p>

        <p>
            Built with Java + Maven + Tomcat
        </p>

    </footer>

</body>

</html>
